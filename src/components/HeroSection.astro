---
import "../styles/global.css";

const { showSearch = false, showTabs = false } = Astro.props;
---

<section class="hero">
  <div class="hero-content">
    <h1>Path To Nowhere Archive</h1>
    <div class="site-note">
      <div class="note-content">
        <p>
          This site is currently under development. Please bear with us as we
          continue to build out the content.
        </p>
        <p>
          You can reach out on <a
            href="https://t.me/TheNowhereArchive"
            class="telegram-link">Telegram</a
          > for updates and support.
        </p>
        <p class="donate">
          If you want to support the site you can do so by reporting errors,
          bugs or missing files.
        </p>
      </div>
      <br />
      {
        showSearch && (
          <div class="search-container">
            <input
              type="text"
              id="searchInput"
              class="search-input"
              placeholder="Search characters..."
              autocomplete="off"
            />
            <span class="search-shortcut" title="Press / to search">
              /
            </span>
            <button class="search-button" id="searchButton">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
              </svg>
            </button>
          </div>
        )
      }

      {
        showTabs && (
          <div class="dynamic-tabs" id="navbarTabs">
            <slot name="tabs" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .center-container {
    display: flex;
    justify-content: center;
    margin: 20px;
  }

  .dynamic-tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem auto 2rem;
    max-width: 1200px;
    padding: 0 1rem;
  }

  .dynamic-tabs button {
    padding: 0.5rem 1.25rem;
    border: none;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.1);
    color: #e0e0e0;
    font-family: "Lato", sans-serif;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .dynamic-tabs button:hover {
    background: rgba(156, 17, 17, 0.3);
    color: white;
  }

  .dynamic-tabs button.active {
    background: #9c1111;
    color: white;
    font-weight: 600;
  }

  .search-container {
    position: relative;
    max-width: 600px;
    margin: 2rem auto;
    width: 100%;
  }

  .search-input {
    width: 100%;
    padding: 1rem 1.5rem;
    padding-right: 8rem;
    font-size: 1.1rem;
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 50px;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(10px);
    color: white;
    transition: all 0.3s ease;
  }

  .search-input::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  .search-shortcut {
    position: absolute;
    right: 3.5rem;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
    font-family: monospace;
    pointer-events: none;
    opacity: 0.6;
    transition: all 0.3s ease;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    background: transparent;
    border: none;
    padding: 0;
  }

  .search-container:focus-within .search-shortcut {
    opacity: 0;
    transform: translateY(-50%) scale(0.9);
  }

  .search-input:focus {
    outline: none;
    border-color: #9c1111;
    box-shadow: 0 0 0 3px rgba(156, 17, 17, 0.3);
  }

  @media (max-width: 768px) {
    .search-input {
      padding: 0.625rem 1rem;
      padding-right: 3.5rem;
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .search-input {
      padding: 0.5rem 0.75rem;
      padding-right: 2.75rem;
      font-size: 0.875rem;
    }
  }

  .search-button {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 50%;
    transition: all 0.2s ease;
  }

  .search-button:hover {
    color: white;
    background: rgba(255, 255, 255, 0.1);
  }
</style>
