---
import Layout from "../../layouts/Layout.astro";
import NavBar from "../../components/NavBar.astro";
import "../../styles/calculator.css";
---

<Layout
  title="Damage Calculator · Path To Nowhere Archive"
  description="Calculate damage for Path to Nowhere sinners."
>
  <NavBar />

  <div class="hero">
    <h1>Damage Calculator</h1>
    <div class="hero-sub">Path to Nowhere Damage Calculator</div>
  </div>

  <!-- ═══ TABS ═══ -->
  <div class="tabs-container">
    <div class="tabs-nav">
      <button class="tab-btn on" data-tab="damage">Damage Calculator</button>
      <button class="tab-btn" data-tab="speed">Attack Speed</button>
    </div>
  </div>

  <div class="app">
    <!-- ═══ DAMAGE TAB ═══ -->
    <div class="tab-content active" data-tab="damage">
      <div class="cols">
        <!-- ═══ LEFT COL ═══ -->
        <div>
          <div class="card">
            <div class="card-head">
              <div class="stripe red"></div>
              <div class="card-title">Caster</div>
              <div class="card-hint" id="hero-badge">no sinner loaded</div>
            </div>
            <div class="card-body">
              <div class="field">
                <div class="flabel"><span class="ln">Select Sinner</span></div>
                <select id="hero-select"
                  ><option value="">— choose a sinner —</option></select
                >
              </div>

              <div class="field">
                <div class="flabel">
                  <span class="ln">Level</span><span class="lv" id="lv-v"
                    >80</span
                  >
                </div>
                <input type="range" id="level" min="1" max="90" value="80" />
              </div>

              <div class="field">
                <div class="flabel"><span class="ln">Grade</span></div>
                <div class="seg" id="grade-seg">
                  <button class="seg-btn on" data-g="0">G0</button>
                  <button class="seg-btn" data-g="1">G1</button>
                  <button class="seg-btn" data-g="2">G2</button>
                  <button class="seg-btn" data-g="3">G3</button>
                </div>
              </div>

              <!-- Shackles -->
              <div class="field" id="chains-field" style="display:none">
                <div class="flabel">
                  <span class="ln">Shackles</span>
                  <span class="lv" id="chains-atk-label"></span>
                </div>
                <div id="chains-list"></div>
              </div>
              <div class="sep" id="chains-sep" style="display:none"></div>

              <!-- Characteristic -->
              <div class="field" id="char-field" style="display:none">
                <div class="flabel">
                  <span class="ln">Characteristic</span>
                  <span class="passive-tag">always active</span>
                </div>
                <div id="char-list"></div>
              </div>
              <div class="sep" id="char-sep" style="display:none"></div>

              <!-- Phase Passives -->
              <div class="field" id="phase-field" style="display:none">
                <div class="flabel">
                  <span class="ln">Phase Passives</span>
                  <span class="passive-tag">toggle if unlocked</span>
                </div>
                <div id="phase-list"></div>
              </div>
              <div class="sep" id="phase-sep" style="display:none"></div>

              <div class="field">
                <div class="flabel">
                  <span class="ln">In-battle ATK% bonus</span>
                </div>
                <input
                  type="number"
                  id="atkPct"
                  value="0"
                  min="0"
                  max="999"
                  step="0.1"
                  placeholder="e.g. 17"
                />
                <div class="hint">
                  Passive buffs not on stat screen · shackle/char ATK%
                  auto-added
                </div>
              </div>

              <div class="atk-strip">
                <span class="ak">Base ATK</span>
                <span class="av" id="strip-base">—</span>
                <span class="arr">×in-battle% →</span>
                <span class="av" id="strip-combat">—</span>
              </div>

              <details class="advanced-wrap">
                <summary class="advanced-toggle">Advanced overrides</summary>
                <div class="advanced-body">
                  <div class="field">
                    <div class="flabel">
                      <span class="ln">Compliance flat ATK</span>
                    </div>
                    <input
                      type="number"
                      id="complianceAtk"
                      value="0"
                      min="0"
                      placeholder="0"
                    />
                  </div>
                  <div class="field">
                    <div class="flabel">
                      <span class="ln">Override stat-screen ATK</span>
                    </div>
                    <input
                      type="number"
                      id="statAtkOverride"
                      placeholder="optional — paste from stat screen"
                      min="1"
                    />
                    <div class="hint">
                      Leave blank to auto-calculate · exclude crimebrand stats
                    </div>
                  </div>
                </div>
              </details>

              <div class="sep"></div>

              <div class="field">
                <div class="flabel"><span class="ln">Skill Type</span></div>
                <div class="seg" id="skill-type-seg">
                  <button class="seg-btn on" data-st="normal">Normal Atk</button
                  >
                  <button class="seg-btn" data-st="skill">Active Skill</button>
                  <button class="seg-btn" data-st="ultimate">Ultimate</button>
                  <button class="seg-btn" data-st="any">Any</button>
                </div>
                <div class="hint" id="skill-type-note">
                  Normal Attack Damage Bonus applies · Skill Damage Bonus does
                  not
                </div>
              </div>

              <div class="field">
                <div class="flabel"><span class="ln">Skill</span></div>
                <select id="skill-select"
                  ><option value="">— select sinner first —</option></select
                >
              </div>

              <div class="row2">
                <div class="field">
                  <div class="flabel">
                    <span class="ln">Skill Level</span><span
                      class="lv"
                      id="skill-lv-v">10</span
                    >
                  </div>
                  <input
                    type="range"
                    id="skillLv"
                    min="1"
                    max="10"
                    value="10"
                  />
                </div>
                <div class="field">
                  <div class="flabel">
                    <span class="ln">Damage Coefficient %</span>
                  </div>
                  <input
                    type="number"
                    id="skillCo"
                    value="100"
                    min="0.1"
                    max="9999"
                    step="0.1"
                    placeholder="e.g. 153"
                  />
                </div>
              </div>

              <!-- Skill Buffs -->
              <div class="field" id="skill-buffs-field" style="display:none">
                <div class="flabel">
                  <span class="ln">Skill Effects</span>
                  <span class="passive-tag"
                    >toggle what applies to this hit</span
                  >
                </div>
                <div id="skill-buffs-list"></div>
              </div>
              <div class="sep" id="skill-buffs-sep" style="display:none"></div>

              <div class="field">
                <div class="flabel"><span class="ln">Damage Type</span></div>
                <div class="seg">
                  <button class="seg-btn on" id="dt-ap" onclick="setDT('AP')"
                    >Magic · vs MagRes</button
                  >
                  <button class="seg-btn" id="dt-ad" onclick="setDT('AD')"
                    >Physical · vs Armor</button
                  >
                  <button class="seg-btn" id="dt-td" onclick="setDT('TD')"
                    >True · ignores def</button
                  >
                </div>
              </div>

              <div class="sep"></div>

              <div class="row2">
                <div class="field">
                  <div class="flabel">
                    <span class="ln">Penetration %</span>
                  </div>
                  <input
                    type="number"
                    id="penPct"
                    value="0"
                    min="0"
                    max="100"
                    step="0.1"
                    placeholder="0"
                  />
                  <div class="hint">Ignores this % of enemy defense</div>
                </div>
                <div class="field">
                  <div class="flabel">
                    <span class="ln">Flat Penetration</span>
                  </div>
                  <input
                    type="number"
                    id="penFlat"
                    value="0"
                    min="0"
                    placeholder="0"
                  />
                  <div class="hint">Subtracts directly from defense</div>
                </div>
              </div>

              <div class="sep"></div>

              <div class="tog-row">
                Critical Hit
                <label class="tog">
                  <input type="checkbox" id="isCrit" />
                  <div class="tog-track"></div><div class="tog-thumb"></div>
                </label>
              </div>
              <div class="field" style="margin-top:.6rem">
                <div class="flabel">
                  <span class="ln">Crit Damage Bonus %</span><span
                    class="lv"
                    id="cb-v">150%</span
                  >
                </div>
                <input
                  type="range"
                  id="critB"
                  min="100"
                  max="500"
                  value="150"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- ═══ RIGHT COL ═══ -->
        <div>
          <div class="card">
            <div class="card-head">
              <div class="stripe dim"></div>
              <div class="card-title">Target Enemy</div>
              <div class="card-hint" id="mon-badge">manual entry</div>
            </div>
            <div class="card-body">
              <div class="field">
                <div class="flabel">
                  <span class="ln">Quick Select Boss</span>
                </div>
                <div class="seg" id="boss-presets">
                  <button
                    class="seg-btn"
                    data-armor="500"
                    data-mr="150"
                    data-dt="AP">Rancor Desire</button
                  >
                  <button
                    class="seg-btn"
                    data-armor="150"
                    data-mr="500"
                    data-dt="AD">Apostle of Stardust</button
                  >
                  <button
                    class="seg-btn"
                    data-armor="160"
                    data-mr="160"
                    data-dt="AP">Alchemic Beast</button
                  >
                </div>
                <div class="hint" id="boss-hint">
                  select a boss to auto-fill defense stats
                </div>
              </div>

              <div class="field">
                <div class="flabel">
                  <span class="ln">Enemy Level</span><span class="lv" id="ml-v"
                    >92</span
                  >
                </div>
                <input type="range" id="monLv" min="1" max="200" value="92" />
              </div>

              <div class="row2">
                <div class="field">
                  <div class="flabel"><span class="ln">Base Armor</span></div>
                  <input type="number" id="baseArmor" value="500" min="0" />
                </div>
                <div class="field">
                  <div class="flabel">
                    <span class="ln">Base Magic Resist</span>
                  </div>
                  <input type="number" id="baseMR" value="150" min="0" />
                </div>
              </div>

              <div class="atk-strip">
                <span class="ak">Scaled defense</span><span
                  class="av"
                  id="scaled-def-val">—</span
                >
                <span class="arr">→ after pen →</span><span
                  class="av"
                  id="eff-def-val">—</span
                >
              </div>

              <div class="sep"></div>

              <div
                class="card-head"
                style="margin:0 -1.25rem .875rem;padding:.6rem 1.25rem"
              >
                <div class="stripe red"></div>
                <div class="card-title">
                  Enemy Debuffs (target takes more damage)
                </div>
              </div>

              <div class="row2">
                <div class="field">
                  <div class="flabel">
                    <span class="ln">All damage taken +%</span>
                  </div>
                  <input
                    type="number"
                    id="takeDmgRate"
                    value="0"
                    min="0"
                    max="999"
                    step="0.1"
                    placeholder="0"
                  />
                  <div class="hint">e.g. Shalom S3: 4% × stacks</div>
                </div>
                <div class="field">
                  <div class="flabel">
                    <span class="ln">Physical taken +%</span>
                  </div>
                  <input
                    type="number"
                    id="takePDmgRate"
                    value="0"
                    min="0"
                    max="999"
                    step="0.1"
                    placeholder="0"
                  />
                  <div class="hint">Physical hits only</div>
                </div>
              </div>
              <div class="field">
                <div class="flabel">
                  <span class="ln">Magic damage taken +%</span>
                </div>
                <input
                  type="number"
                  id="takeMDmgRate"
                  value="0"
                  min="0"
                  max="999"
                  step="0.1"
                  placeholder="0"
                />
                <div class="hint">Magic hits only</div>
              </div>

              <div class="sep"></div>

              <div class="tog-row">
                Core is broken (activates breaking damage bonuses)
                <label class="tog"
                  ><input type="checkbox" id="coreBroken" /><div
                    class="tog-track"
                  >
                  </div><div class="tog-thumb"></div></label
                >
              </div>
              <div class="tog-row">
                Target is a Boss
                <label class="tog"
                  ><input type="checkbox" id="isBoss" /><div class="tog-track">
                  </div><div class="tog-thumb"></div></label
                >
              </div>
              <div class="tog-row">
                Target is an Elite
                <label class="tog"
                  ><input type="checkbox" id="isElite" /><div class="tog-track">
                  </div><div class="tog-thumb"></div></label
                >
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-head">
              <div class="stripe red"></div>
              <div class="card-title">Damage Bonuses</div>
              <div class="card-hint">
                same type adds · different types multiply
              </div>
            </div>
            <div class="card-body" id="mult-container"></div>
          </div>

          <div class="result-main">
            <div class="big-nums">
              <div class="bnum">
                <div class="bnum-lbl">Hit (floored)</div>
                <div class="bnum-val red" id="o-hit">—</div>
                <div class="bnum-sub" id="o-co">—</div>
              </div>
              <div class="bnum">
                <div class="bnum-lbl">Pre-floor exact</div>
                <div class="bnum-val white" id="o-raw">—</div>
                <div class="bnum-sub">float value</div>
              </div>
              <div class="bnum">
                <div class="bnum-lbl">Crit Hit</div>
                <div class="bnum-val dim" id="o-crit">—</div>
                <div class="bnum-sub" id="o-cn">×1.50</div>
              </div>
              <div class="bnum">
                <div class="bnum-lbl">Min floor?</div>
                <div class="bnum-val soft" id="o-floor">NO</div>
                <div class="bnum-sub" id="o-floor-sub">—</div>
              </div>
            </div>
            <div class="bdown-wrap">
              <div class="bdown-grid" id="bdown"></div>
            </div>
            <div class="chain-bar">
              <div class="chain-lbl">Damage multiplier chain</div>
              <div class="chain-cats" id="chain-cats"></div>
              <div class="chain-eq" id="chain-eq"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ SPEED TAB ═══ -->
    <div class="tab-content" data-tab="speed">
      <!-- ═══ ATTACK SPEED SECTION ═══ -->
      <div class="atk-speed-section">
        <div class="card">
          <div class="card-head">
            <div class="stripe red"></div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <div class="card-title">Attack Speed</div>
              <button
                id="as-help-btn"
                class="card-help-btn"
                title="Show explanation">?</button
              >
            </div>
            <div class="card-hint">
              breakpoint calculator · 15 fps logic engine
            </div>
          </div>
          <div class="card-body">
            <div class="field">
              <div class="flabel">
                <span class="ln">Base attack speed</span>
              </div>
              <input
                type="number"
                id="as-base"
                value=""
                min="0.01"
                step="0.0001"
                placeholder="e.g. 0.86"
              />
              <div class="hint" id="as-base-note"></div>
            </div>

            <div class="row2" style="margin-top:.5rem">
              <div class="field">
                <div class="flabel">
                  <span class="ln">Total attack speed bonus %</span>
                </div>
                <div id="as-bonus-container"></div>
                <div class="hint">click to toggle · X to remove</div>
              </div>
              <div class="field">
                <div class="flabel">
                  <span class="ln">Flat attack speed bonus</span>
                </div>
                <div id="as-flat-container"></div>
                <div class="hint">added to final speed after % scaling</div>
              </div>
            </div>

            <div class="atk-strip" id="as-result-strip">
              <span class="ak">Final speed</span>
              <span class="av" id="as-final">—</span>
              <span class="arr">→ frames per attack →</span>
              <span class="av red" id="as-frames">—</span>
            </div>

            <div class="sep"></div>

            <!-- Breakpoint display -->
            <div class="flabel" style="margin-bottom:.5rem">
              <span class="ln">Current breakpoint</span>
            </div>
            <div id="as-bp-current"></div>

            <div class="sep"></div>

            <!-- Worth it checker -->
            <div class="flabel" style="margin-bottom:.4rem">
              <span class="ln">Would it push me over?</span>
            </div>
            <div class="row2">
              <div class="field">
                <div class="flabel">
                  <span class="ln">Check this bonus %</span>
                </div>
                <input
                  type="number"
                  id="as-check"
                  value=""
                  min="0"
                  step="0.1"
                  placeholder="e.g. 10"
                />
              </div>
              <div class="field" style="justify-content:flex-end">
                <div id="as-check-result"></div>
              </div>
            </div>

            <div class="sep"></div>

            <!-- Attacks over time -->
            <div class="flabel" style="margin-bottom:.4rem">
              <span class="ln">Attacks over time</span>
            </div>
            <div class="row2">
              <div class="field">
                <div class="flabel"><span class="ln">Minutes</span></div>
                <input
                  type="number"
                  id="as-attack-minutes"
                  value="0"
                  min="0"
                  placeholder="0"
                />
              </div>
              <div class="field">
                <div class="flabel"><span class="ln">Seconds</span></div>
                <input
                  type="number"
                  id="as-attack-seconds"
                  value="30"
                  min="0"
                  max="59"
                  placeholder="e.g. 30"
                />
              </div>
            </div>
            <div
              id="as-attacks-result"
              class="as-current-box"
              style="margin-top:.5rem"
            >
              <div class="as-box-item">
                <div class="as-box-lbl">Attacks / second</div>
                <div class="as-box-val">—</div>
              </div>
              <div class="as-box-item">
                <div class="as-box-lbl">Attacks / minute</div>
                <div class="as-box-val">—</div>
              </div>
            </div>

            <div class="sep"></div>

            <!-- Nearby breakpoints -->
            <div class="flabel" style="margin-bottom:.5rem">
              <span class="ln">Nearby breakpoints</span>
            </div>
            <div id="as-bp-list"></div>
          </div>
        </div>
      </div>

      <!-- ═══ ATTACK SPEED HELP MODAL ═══ -->
      <div id="as-help-modal" class="modal-overlay" style="display:none">
        <div class="modal-content">
          <div class="modal-header">
            <div class="modal-title">Attack Speed Breakpoints</div>
            <button id="as-help-close" class="modal-close">✕</button>
          </div>
          <div class="modal-body">
            <p>
              The frame rate of normal attacks in battles is 15. This means:
            </p>
            <ul style="margin: 0.5rem 0 1rem 1.5rem; line-height: 1.6;">
              <li>
                If your attack speed is <strong>1.0</strong>, one attack takes <strong
                  >15 frames</strong>
              </li>
              <li>
                If your attack speed is <strong>15.0</strong>, one attack takes <strong
                  >1 frame</strong>
              </li>
              <li>Higher speed = fewer frames per attack</li>
            </ul>

            <p>
              <strong>The problem:</strong> Attack speed buffs only matter if they
              push you to a faster frame tier. In between breakpoints, bonuses do
              nothing.
            </p>

            <p>
              <strong>Example:</strong> Your sinner has attack speed 1.01 (which takes
              15 frames). You want to add a Crimebrand buff. Would a 5% buff help?
            </p>

            <p>
              <strong>Calculation:</strong>
              <code
                style="font-family: monospace; background: rgba(255,255,255,0.05); padding: 0.2rem 0.4rem; border-radius: 2px;"
                >1.01 × 1.05 = 1.0605</code>
            </p>

            <p>
              According to the table below, to reach <strong>14 frames</strong> you
              need speed ≥ <strong>1.07142</strong>. Your new speed (1.0605) is
              still below that threshold, so <strong
                >the buff does nothing</strong
              >,you're still at 15 frames.
            </p>

            <p>
              <strong>But with a 10% buff:</strong>
              <code
                style="font-family: monospace; background: rgba(255,255,255,0.05); padding: 0.2rem 0.4rem; border-radius: 2px;"
                >1.01 × 1.10 = 1.111</code>
            </p>

            <p>
              Now 1.111 is above 1.07142, so you break into <strong
                >14 frames</strong
              >.
            </p>

            <p
              style="margin-top: 1rem; margin-bottom: 0.5rem; font-weight: 700; font-size: 0.85rem;"
            >
              Frame breakpoints (No fancy formula is needed for the Breakpoint,
              just 15 ÷ frame):
            </p>

            <div
              style="overflow-y: auto; max-height: 250px; font-size: 0.75rem;"
            >
              <table style="width: 100%; border-collapse: collapse;">
                <thead>
                  <tr
                    style="position: sticky; top: 0; background: rgba(0,0,0,0.7); border-bottom: 1px solid rgba(255,255,255,0.1);"
                  >
                    <th style="padding: 0.4rem; text-align: left;">Frame</th>
                    <th style="padding: 0.4rem; text-align: left;">Min Speed</th
                    >
                  </tr>
                </thead>
                <tbody>
                  <tr
                    ><td style="padding: 0.3rem 0.4rem;">1</td><td
                      style="padding: 0.3rem 0.4rem; font-family: monospace;"
                      >15.00000</td
                    ></tr
                  >
                  <tr
                    ><td style="padding: 0.3rem 0.4rem;">2</td><td
                      style="padding: 0.3rem 0.4rem; font-family: monospace;"
                      >7.50000</td
                    ></tr
                  >
                  <tr
                    ><td style="padding: 0.3rem 0.4rem;">3</td><td
                      style="padding: 0.3rem 0.4rem; font-family: monospace;"
                      >5.00000</td
                    ></tr
                  >
                  <tr
                    ><td style="padding: 0.3rem 0.4rem;">4</td><td
                      style="padding: 0.3rem 0.4rem; font-family: monospace;"
                      >3.75000</td
                    ></tr
                  >
                  <tr
                    ><td style="padding: 0.3rem 0.4rem;">5</td><td
                      style="padding: 0.3rem 0.4rem; font-family: monospace;"
                      >3.00000</td
                    ></tr
                  >
                  <tr
                    ><td style="padding: 0.3rem 0.4rem;">10</td><td
                      style="padding: 0.3rem 0.4rem; font-family: monospace;"
                      >1.50000</td
                    ></tr
                  >
                  <tr
                    ><td style="padding: 0.3rem 0.4rem;">14</td><td
                      style="padding: 0.3rem 0.4rem; font-family: monospace;"
                      >1.07142</td
                    ></tr
                  >
                  <tr
                    ><td style="padding: 0.3rem 0.4rem;">15</td><td
                      style="padding: 0.3rem 0.4rem; font-family: monospace;"
                      >1.00000</td
                    ></tr
                  >
                  <tr
                    ><td style="padding: 0.3rem 0.4rem;">16</td><td
                      style="padding: 0.3rem 0.4rem; font-family: monospace;"
                      >0.93750</td
                    ></tr
                  >
                  <tr
                    ><td style="padding: 0.3rem 0.4rem;">20</td><td
                      style="padding: 0.3rem 0.4rem; font-family: monospace;"
                      >0.75000</td
                    ></tr
                  >
                  <tr
