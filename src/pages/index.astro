---
import NavBar from "../components/NavBar.astro";
import MainHeroSection from "../components/MainHeroSection.astro";
import { ASSET_MAIN_URL } from "../config/config";
import Layout from "../layouts/Layout.astro";
import "../styles/main.css";
import "../styles/global.css";
---

<Layout
  title="Path To Nowhere Archive - Character Voicelines & CG Database"
  description="Complete Path To Nowhere archive featuring all character voicelines, CG galleries, and game content. Listen to Sinner quotes and explore story scenes."
>
  <NavBar />
  <MainHeroSection />

  <main class="main-content">
    <h2 class="section-title">Featured Content</h2>
    <div class="grid-container">
      <a href={"/characters/"} class="container-link">
        <div class="skeleton"></div>
        <img
          class="image-default"
          src={`${ASSET_MAIN_URL}/Hella1.png`}
          alt="Hella"
          onload="this.style.display='block'; this.previousElementSibling.style.display='none';"
        />
        <img
          class="image-hover"
          src={`${ASSET_MAIN_URL}/Hella2.png`}
          alt="Hella"
        />
        <div class="text">Characters Voicelines</div>
      </a>

      <a href={"/cgs/"} class="container-link">
        <div class="skeleton"></div>
        <img
          class="image-default"
          src={`${ASSET_MAIN_URL}/Hecate1.png`}
          alt="Hecate"
          onload="this.style.display='block'; this.previousElementSibling.style.display='none';"
        />
        <img
          class="image-hover"
          src={`${ASSET_MAIN_URL}/Hecate2.png`}
          alt="Hecate"
        />
        <div class="text">In-Game CGs</div>
      </a>
    </div>
  </main>

  <script>
    import { doAll as initMain } from "../utils/main.js";
    import { doAll as initSearch } from "../utils/search.js";
    import { doAll as initUtilities } from "../utils/utilities.js";

    initMain();
    initSearch();
    initUtilities();
  </script>
</Layout>
