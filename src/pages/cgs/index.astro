---
import "../../styles/global.css";
import NavBar from "../../components/NavBar.astro";
import HeroSection from "../../components/HeroSection.astro";
import { ASSET_CGS_THUMBNAILS_URL, REPO } from "../../config/config";
import Layout from "../../layouts/Layout.astro";

const chaptersResponse = await fetch(`${REPO}/chapters.json`);
const chapters = await chaptersResponse.json();

const categories = Object.keys(chapters);

const allChapters = Object.entries(chapters).flatMap(
  ([category, chapterList]) =>
    (chapterList as any[]).map((chapter) => ({ ...chapter, category })),
);
---

<Layout title="CGs">
  <NavBar />
  <HeroSection showSearch={true} showTabs={true}>
    <div slot="tabs">
      <button class="tab-button active" data-category="all">All Chapters</button
      >
      {
        categories.map((category) => (
          <button class="tab-button" data-category={category}>
            {category}
          </button>
        ))
      }
    </div>
  </HeroSection>

  <div class="center-container">
    {
      allChapters.map((chapter) => (
        <a href={`/cgs/${chapter.name}`}>
          <div class="chapter-wrapper" data-category={chapter.category}>
            <div class="chapter-card" data-chapter-name={chapter.name}>
              <div class="skeleton" />
              <img
                src={`${ASSET_CGS_THUMBNAILS_URL}/${chapter.name}/${chapter.name}.png`}
                alt={chapter.displayName}
                onload="this.style.opacity=1; this.previousElementSibling.style.display='none';"
              />
              <div class="chapter-title">{chapter.displayName}</div>
            </div>
          </div>
        </a>
      ))
    }
  </div>

  <style>
    .center-container {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 2rem;
      padding: 0 2rem;
      max-width: 1400px;
      margin: 0 auto;
    }

    .chapter-card {
      position: relative;
      aspect-ratio: 16/9;
      overflow: hidden;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
      cursor: pointer;
      background: #1e1e1e;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .chapter-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    }

    .skeleton {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, #2c2c2c 0%, #3a3a3a 50%, #2c2c2c 100%);
      background-size: 200% 100%;
      animation: skeleton-loading 1.5s infinite;
    }

    @keyframes skeleton-loading {
      0% {
        background-position: 200% 0;
      }
      100% {
        background-position: -200% 0;
      }
    }

    .chapter-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .chapter-title {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 1rem;
      background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
      color: white;
      font-size: 1.1rem;
      font-weight: 600;
      text-align: left;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
    }
  </style>

  <script>
    import { doAll } from "../../utils/global.js";
    doAll();

    const tabButtons = document.querySelectorAll(".tab-button");
    const chapterWrappers = document.querySelectorAll(".chapter-wrapper");
    const searchInput = document.getElementById(
      "searchInput",
    ) as HTMLInputElement;
    const chapterCards = document.querySelectorAll(".chapter-card");

    let currentCategory = "all";

    tabButtons.forEach((button) => {
      button.addEventListener("click", () => {
        currentCategory = button.getAttribute("data-category") || "all";

        tabButtons.forEach((btn) => btn.classList.remove("active"));
        button.classList.add("active");

        filterChapters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener("input", filterChapters);
    }

    chapterCards.forEach((card) => {
      card.addEventListener("click", () => {
        const chapterName = card.getAttribute("data-chapter-name");
        if (chapterName) {
          window.location.href = `/cgs/chapter?name=${chapterName}`;
        }
      });
    });

    function filterChapters() {
      const searchValue = searchInput?.value.toLowerCase().trim() || "";

      chapterWrappers.forEach((wrapper) => {
        const category = wrapper.getAttribute("data-category") || "";
        const title =
          wrapper.querySelector(".chapter-title")?.textContent?.toLowerCase() ||
          "";

        const matchesCategory =
          currentCategory === "all" || category === currentCategory;
        const matchesSearch = !searchValue || title.includes(searchValue);

        // Hide the parent <a> tag, not the wrapper
        const linkElement = wrapper.parentElement as HTMLElement;
        if (linkElement) {
          linkElement.style.display =
            matchesCategory && matchesSearch ? "block" : "none";
        }
      });
    }
  </script>
</Layout>
