---
import "../../../styles/global.css";
import NavBar from "../../../components/NavBar.astro";
import { ASSET_CHAPTERS_URL, ASSET_CGS_THUMBNAILS_URL, REPO } from "../../../config/config";
import Layout from "../../../layouts/Layout.astro";

interface Chapter {
  name: string;
  displayName: string;
}

export async function getStaticPaths() {
  const chaptersResponse = await fetch(`${REPO}/chapters.json`);
  const chapters = await chaptersResponse.json();

  const allChapters = Object.entries(chapters).flatMap(
    ([category, chapterList]) =>
      (chapterList as any[]).map((chapter) => ({ ...chapter, category })),
  );

  return allChapters.map((chapter: any) => ({
    params: {
      cg: chapter.name,
    },
    props: {
      chapterData: chapter,
    },
  }));
}

const { chapterData } = Astro.props;
const chapterName = chapterData.name;
const chapterDisplayName = chapterData.displayName;
---

<Layout
  title={`${chapterDisplayName} - CG Images`}
  description={`View all CG images from ${chapterDisplayName} in Path To Nowhere. High quality chapter illustrations and story scenes.`}
>
  <NavBar />

  <div id="controlsContainer" class="controls-container" style="display: none;">
    <button id="downloadAllBtn" class="download-all-btn" title="Download all images">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="white">
        <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
      </svg>
      Download All
    </button>
  </div>

  <div id="imagesContainer" class="images-container" style="display: flex;">
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

  <script define:vars={{ chapterName, ASSET_CHAPTERS_URL, ASSET_CGS_THUMBNAILS_URL }}>
    const THUMBNAIL_URL = `${ASSET_CGS_THUMBNAILS_URL}/${chapterName}/${chapterName}.png`;

    async function loadImages() {
      const imagesContainer = document.getElementById("imagesContainer");

      // skeleton cards fill viewport
      const skCount = Math.max(4, Math.ceil(window.innerHeight / 280));
      imagesContainer.innerHTML = Array.from({ length: skCount }, () =>
        `<div class="cg-skeleton">
          <div class="cg-skeleton-img"></div>
          <div class="cg-skeleton-bar"></div>
        </div>`
      ).join("");

      try {
        const response = await fetch(
          `${ASSET_CHAPTERS_URL}/${chapterName}.json`,
        );
        if (!response.ok) throw new Error("Error loading");

        const imagesData = await response.json();

        imagesContainer.innerHTML = "";
        renderImages(imagesData);

        const controlsContainer = document.getElementById("controlsContainer");
        if (controlsContainer) controlsContainer.style.display = "flex";
        const downloadAllBtn = document.getElementById("downloadAllBtn");
        if (downloadAllBtn) {
          downloadAllBtn.addEventListener("click", () => downloadAllImages(imagesData));
        }
      } catch (error) {
        imagesContainer.innerHTML = `<div class="loading-state"><p>Error loading images.</p></div>`;
      }
    }

    async function downloadImage(imageUrl) {
      try {
        const response = await fetch(imageUrl);
        const blob = await response.blob();
        const blobUrl = URL.createObjectURL(blob);
        const fileName = imageUrl.split("/").pop() || "image.png";

        const a = document.createElement("a");
        a.href = blobUrl;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);

        URL.revokeObjectURL(blobUrl);
      } catch (error) {
        console.error("Download failed:", error);
        window.open(imageUrl, "_blank");
      }
    }

    async function downloadAllImages(images) {
      const downloadAllBtn = document.getElementById("downloadAllBtn");
      const originalText = downloadAllBtn.innerHTML;
      downloadAllBtn.disabled = true;
      downloadAllBtn.innerHTML = `<svg viewBox="0 0 24 24" width="18" height="18" style="animation: spin 1s linear infinite;"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/></svg> Zipping...`;

      try {
        const zip = new JSZip();
        let loaded = 0;
        const total = images.length + 1; // +1 for thumbnail

        // add thumbnail
        try {
          const thumbResp = await fetch(THUMBNAIL_URL);
          if (thumbResp.ok) {
            const thumbBlob = await thumbResp.blob();
            zip.file(`${chapterName}_thumbnail.png`, thumbBlob);
          }
        } catch (_) {}
        downloadAllBtn.innerHTML = `<svg viewBox="0 0 24 24" width="18" height="18" style="animation: spin 1s linear infinite;"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/></svg> Zipping... (1/${total})`;
        loaded++;

        for (const image of images) {
          const response = await fetch(image.fileName);
          const blob = await response.blob();
          const fileName = image.fileName.split("/").pop() || `image-${loaded}.png`;
          zip.file(fileName, blob);
          loaded++;

          downloadAllBtn.innerHTML = `<svg viewBox="0 0 24 24" width="18" height="18" style="animation: spin 1s linear infinite;"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/></svg> Zipping... (${loaded}/${total})`;
        }

        downloadAllBtn.innerHTML = `<svg viewBox="0 0 24 24" width="18" height="18" style="animation: spin 1s linear infinite;"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/></svg> Creating zip...`;

        const zipBlob = await zip.generateAsync({ type: "blob" });

        const blobUrl = URL.createObjectURL(zipBlob);
        const a = document.createElement("a");
        a.href = blobUrl;
        a.download = `${chapterName}-images.zip`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(blobUrl);

        downloadAllBtn.disabled = false;
        downloadAllBtn.innerHTML = originalText;
      } catch (error) {
        console.error("Download failed:", error);
        downloadAllBtn.disabled = false;
        downloadAllBtn.innerHTML = originalText;
      }
    }

    function renderImages(images) {
      const container = document.getElementById("imagesContainer");
      container.innerHTML = "";

      images.forEach((image) => {
        const imageDiv = document.createElement("div");
        imageDiv.classList.add("image-card");
        imageDiv.innerHTML = `
          <div class="image-wrapper">
            <img 
              src="${image.fileName}" 
              alt="${image.title}"
              loading="lazy"
              class="cg-image"
            />
            <div class="image-actions" style="display: none;">
              <button class="action-btn download-btn" title="Download" data-image="${image.fileName}">
                <svg viewBox="0 0 24 24" width="16" height="16">
                  <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                </svg>
              </button>
            </div>
          </div>
        `;

        const img = imageDiv.querySelector(".cg-image");
        const actions = imageDiv.querySelector(".image-actions");
        const downloadBtn = imageDiv.querySelector(".download-btn");

        img.addEventListener("load", () => {
          actions.style.display = "flex";
        });

        if (downloadBtn) {
          downloadBtn.addEventListener("click", async (e) => {
            e.preventDefault();
            e.stopPropagation();
            const imageUrl = downloadBtn.getAttribute("data-image");
            await downloadImage(imageUrl);
          });
        }

        container.appendChild(imageDiv);
      });
    }

    loadImages();
  </script>
</Layout>

<style>
  .loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 50vh;
    padding: 2rem;
    color: var(--text-secondary);
  }

  .loading-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(156, 17, 17, 0.2);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 1rem;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .loading-state p {
    font-size: 0.9rem;
    opacity: 0.7;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 0.5rem;
  }

  .image-wrapper:hover .image-actions {
    opacity: 1;
  }

  .image-actions {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    gap: 0.5rem;
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 10;
  }

  .action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background-color: rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0.375rem;
    cursor: pointer;
    color: #ffffff;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .action-btn:hover {
    background-color: rgba(0, 0, 0, 0.8);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .action-btn svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .controls-container {
    justify-content: center;
    display: flex;
    gap: 1rem;
    padding: 1.5rem 2rem;
    margin: 0 2rem;
    margin-top: 4rem;
    position: relative;
    z-index: 1;
  }

  .download-all-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background-color: var(--primary, #9c1111);
    border: 1px solid rgba(156, 17, 17, 0.5);
    border-radius: 0.375rem;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .download-all-btn:hover:not(:disabled) {
    background-color: rgba(156, 17, 17, 0.8);
    border-color: rgba(156, 17, 17, 0.7);
  }

  .download-all-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .download-all-btn svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .cg-skeleton {
    background: var(--surface);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.05);
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .cg-skeleton-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: rgba(255, 255, 255, 0.04);
  }

  .cg-skeleton-bar {
    height: 14px;
    margin: 12px 16px;
    width: 50%;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
  }

  @keyframes skeleton-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
</style>
