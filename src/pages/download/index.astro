---
import NavBar from "../../components/NavBar.astro";
import "../../styles/global.css";
import { REPO, ASSET_CGS_URL } from "../../config/config";
import Layout from "../../layouts/Layout.astro";

const charactersRes = await fetch(`${REPO}/characters.json`);
const charactersData = await charactersRes.json();
const chaptersRes = await fetch(`${ASSET_CGS_URL}/chapters.json`);
const chaptersData = await chaptersRes.json();
const languages = ["english", "japanese", "chinese", "korean"];
---

<Layout title="Download">
  <NavBar />
  <section class="hero">
    <div class="hero-content">
      <h1>Download</h1>
      <div class="site-note">
        <p>Select CGs and voicelines to download as a single ZIP bundle.</p>
      </div>
      <div class="search-container">
        <input
          type="text"
          id="searchInput"
          class="search-input"
          placeholder="Filter..."
          autocomplete="off"
        />
        <span class="search-shortcut">/</span>
      </div>
    </div>
  </section>

  <!-- Sticky Action Bar -->
  <div class="action-bar" id="actionBar">
    <div class="action-bar-inner">
      <div class="view-tabs" id="viewTabs">
        <button class="view-tab active" data-view="all">All</button>
        <button class="view-tab" data-view="cgs">CGs</button>
        <button class="view-tab" data-view="voicelines">Voicelines</button>
      </div>
      <span class="selection-info" id="selectedCount">0 selected</span>
      <div class="header-select-all">
        <button class="header-select-btn" id="selectAllCGs"
          >Select All CGs</button
        >
        <button class="header-select-btn" id="selectAllVLs"
          >Select All Voicelines</button
        >
        <span class="header-select-divider"></span>
        <button class="header-select-btn deselect" id="deselectAll"
          >Deselect All</button
        >
      </div>
      <button class="download-btn" id="downloadBtn" disabled>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline
            points="7 10 12 15 17 10"></polyline><line
            x1="12"
            y1="15"
            x2="12"
            y2="3"></line></svg
        >
        <span>Download Selected</span>
        <span class="download-spinner" id="downloadSpinner"></span>
      </button>
    </div>
  </div>

  <div class="download-warning">
    <div class="download-warning-inner">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path
          d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
        ></path><line x1="12" y1="9" x2="12" y2="13"></line><line
          x1="12"
          y1="17"
          x2="12.01"
          y2="17"></line></svg
      >
      <span
        >Generating large downloads may take a while or fail. Consider downloading
        in smaller batches.</span
      >
    </div>
    <button
      id="downloadHelpBtn"
      class="download-help-btn"
      type="button"
      title="Explain client-side downloads"
      >?</button
    >
  </div>

  <div id="downloadHelpModal" class="download-help-overlay" style="display:none">
    <div class="download-help-content">
      <div class="download-help-header">
        <div class="download-help-title">Client-side download</div>
        <button id="downloadHelpClose" class="download-help-close" type="button">
          ✕
        </button>
      </div>
      <div class="download-help-body">
        <p>
          When the download server is offline, this page builds the ZIP directly in
          your browser instead of using the remote server.
        </p>
        <ul>
          <li>The page must stay open while the ZIP is being created.</li>
          <li>If you refresh, close the tab, or leave the page, the download can stop.</li>
          <li>Large downloads can take longer and may fail, so smaller batches are more reliable.</li>
          <li>Once the ZIP is finished, the browser will start the file download automatically.</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="server-status-bar" id="serverStatusBar" style="display:none">
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      ><circle cx="12" cy="12" r="10"></circle><line
        x1="12"
        y1="8"
        x2="12"
        y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg
    >
    <span id="serverStatusText"></span>
  </div>

  <div class="download-content" id="downloadContent">
    <section class="dl-section" id="cgsSection" data-section="cgs">
      <div class="dl-section-header">
        <h2>CGs</h2>
        <div class="section-chips" id="cgCategoryChips">
          <button class="chip active" data-cg-cat="all">All</button>
        </div>
      </div>
      <div class="tree" id="cgsTree"></div>
    </section>

    <section
      class="dl-section"
      id="voicelinesSection"
      data-section="voicelines"
    >
      <div class="dl-section-header">
        <h2>Voicelines</h2>
        <div class="section-chips" id="vlCategoryChips">
          <button class="chip active" data-vl-cat="all">All</button>
        </div>
        <div class="vl-lang-all">
          <button class="chip" data-lang="english">All EN</button>
          <button class="chip" data-lang="japanese">All JA</button>
          <button class="chip" data-lang="chinese">All ZH</button>
          <button class="chip" data-lang="korean">All KO</button>
        </div>
      </div>
      <div class="tree" id="vlTree"></div>
    </section>
  </div>

  <div class="no-results" id="noResults">Nothing matches your filter</div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <script
    define:vars={{
      CHARACTERS: charactersData.characters,
      CHAPTERS: chaptersData,
      LANGUAGES: languages,
      ASSET_CGS_URL,
      ASSET_AUDIO_URLS: {
        english: "https://raw.githubusercontent.com/NowhereArchive/NowhereAudio-English/main/audio",
        japanese: "https://raw.githubusercontent.com/NowhereArchive/NowhereAudio-Japanese/main/audio",
        chinese: "https://raw.githubusercontent.com/NowhereArchive/NowhereAudio-Chinese/main/audio",
        korean: "https://raw.githubusercontent.com/NowhereArchive/NowhereAudio-Korean/main/audio",
      },
      ASSET_CHARACTERS_URL: `${REPO}/CharactersJson`,
    }}
  >
    const SERVER = "https://server-cu86.onrender.com";
    const CHAPTERS_DATA = CHAPTERS;
    const ASSET_CGS_ROOT = ASSET_CGS_URL;
    const ASSET_CHARACTERS_ROOT = ASSET_CHARACTERS_URL;
    const ASSET_AUDIO_ROOTS = ASSET_AUDIO_URLS;
    let serverAvailable = false;

    function sanitizeName(name = "") {
      return name.toLowerCase().replace(/\s+/g, "_");
    }

    function sanitizeNameForGitHub(name = "") {
      return name.toLowerCase().replace(/\./g, "").replace(/\s+/g, "_");
    }

    function trimFilePrefix(filename = "") {
      return filename.startsWith("File:") ? filename.slice(5) : filename;
    }

    function toBrowserFriendlyCgUrl(url = "") {
      if (!url) return url;

      const releaseUrl = url.match(
        /^https:\/\/github\.com\/NowhereArchive\/NowhereCG\/releases\/download\/([^/]+)\/(.+)$/,
      );
      if (!releaseUrl) return url;

      const [, chapterName, fileName] = releaseUrl;
      return `https://raw.githubusercontent.com/NowhereArchive/NowhereCG/main/CGs/${chapterName}/${fileName}`;
    }

    function showServerStatus(message, kind = "warn") {
      const bar = $("serverStatusBar");
      const text = $("serverStatusText");
      if (!bar || !text) return;
      bar.style.display = "flex";
      bar.className = `server-status-bar ${kind}`;
      text.textContent = message;
    }

    async function checkServerAvailability() {
      try {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 4000);
        const res = await fetch(`${SERVER}/`, {
          method: "GET",
          cache: "no-store",
          signal: controller.signal,
        });
        clearTimeout(timeout);

        if (res.ok) {
          serverAvailable = true;
          showServerStatus("Download server is online.", "ok");
          return true;
        }

        serverAvailable = false;
        showServerStatus(
          "Download server is unavailable. Using the browser ZIP fallback.",
          "warn",
        );
        return false;
      } catch (err) {
        serverAvailable = false;
        showServerStatus(
          "Download server is unavailable. Using the browser ZIP fallback.",
          "warn",
        );
        return false;
      }
    }

    async function buildClientSideZip(voicelines, cgs) {
      const zip = new JSZip();
      const cgEntries = [...new Set(cgs)];
      const vlEntries = Array.from(
        new Map(
          voicelines.map((item) => [
            `${item.slug}|${item.attire}|${item.language}`,
            item,
          ]),
        ).values(),
      );

      for (const chapterName of cgEntries) {
        try {
          const chapterRes = await fetch(`${ASSET_CGS_ROOT}/chapters/${chapterName}.json`);
          if (!chapterRes.ok) continue;
          const chapterImages = await chapterRes.json();
          for (const image of chapterImages || []) {
            const imageUrl = toBrowserFriendlyCgUrl(image.fileName || image.url);
            if (!imageUrl) continue;
            try {
              const imageRes = await fetch(imageUrl);
              if (!imageRes.ok) continue;
              const blob = await imageRes.blob();
              const fileName = imageUrl.split("/").pop() || `${chapterName}.png`;
              zip.file(`${chapterName}/${fileName}`, blob);
            } catch (_) {
            }
          }
        } catch (_) {
        }
      }

      for (const item of vlEntries) {
        try {
          const voiceJsonUrl = `${ASSET_CHARACTERS_ROOT}/${item.slug}_${item.language}.json`;
          const voiceRes = await fetch(voiceJsonUrl);
          if (!voiceRes.ok) continue;
          const voiceData = await voiceRes.json();
          const entries = voiceData[item.attire] || [];
          const folderName = sanitizeNameForGitHub(item.displayName || item.slug);
          const audioBaseUrl = ASSET_AUDIO_ROOTS[item.language] || ASSET_AUDIO_ROOTS.english;

          for (const entry of entries) {
            const rawFilename = trimFilePrefix(entry.filename || "");
            if (!rawFilename) continue;
            const audioUrl = `${audioBaseUrl}/${folderName}/${item.language}/${item.attire}/${sanitizeName(rawFilename)}`;
            try {
              const audioRes = await fetch(audioUrl);
              if (!audioRes.ok) continue;
              const blob = await audioRes.blob();
              const safeName = rawFilename.split("/").pop() || `${item.slug}_${item.language}.audio`;
              zip.file(`voicelines/${folderName}/${item.language}/${item.attire}/${safeName}`, blob);
            } catch (_) {
            }
          }
        } catch (_) {
        }
      }

      const zipBlob = await zip.generateAsync({ type: "blob" });
      const blobUrl = URL.createObjectURL(zipBlob);
      const a = document.createElement("a");
      a.href = blobUrl;
      a.download = "nowhere-download-bundle.zip";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(blobUrl);
    }

    async function runDownloadFlow(voicelines, cgs) {
      if (serverAvailable) {
        try {
          const res = await fetch(`${SERVER}/bundle/prepare`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ voicelines, cgs }),
          });
          const { token } = await res.json();
          window.location.href = `${SERVER}/download/bundle/${token}`;
          return;
        } catch (err) {
          console.warn("Server bundle endpoint failed, using fallback.", err);
        }
      }

      await buildClientSideZip(voicelines, cgs);
    }

    const allChapters = Object.entries(CHAPTERS_DATA).flatMap(([cat, list]) =>
      list.map((ch) => ({ ...ch, category: cat })),
    );

    const $ = (id) => document.getElementById(id);
    const cgsTree = $("cgsTree");
    const vlTree = $("vlTree");
    const searchInput = $("searchInput");
    const selectedCount = $("selectedCount");
    const downloadBtn = $("downloadBtn");
    const downloadSpinner = $("downloadSpinner");
    const noResults = $("noResults");
    const cgCategoryChips = $("cgCategoryChips");
    const vlCategoryChips = $("vlCategoryChips");
    const downloadHelpBtn = $("downloadHelpBtn");
    const downloadHelpModal = $("downloadHelpModal");
    const downloadHelpClose = $("downloadHelpClose");

    const viewTabs = document.querySelectorAll(".view-tab");
    const selectAllCGs = $("selectAllCGs");
    const selectAllVLs = $("selectAllVLs");
    const deselectAll = $("deselectAll");
    const langAllBtns = document.querySelectorAll(
      ".vl-lang-all .chip[data-lang]",
    );

    let currentView = "all";
    let searchQuery = "";
    let cgCategoryFilter = "all";
    let vlCategoryFilter = "all";

    const selectedCGs = new Set();
    const selectedVLs = new Map();
    const collapsedCGs = new Set();
    const collapsedChars = new Set();

    function renderCGs() {
      const cats = [...new Set(allChapters.map((c) => c.category))];
      const fragment = document.createDocumentFragment();

      cats.forEach((cat) => {
        const items = allChapters
          .filter((ch) => {
            if (cgCategoryFilter !== "all" && ch.category !== cgCategoryFilter)
              return false;
            if (
              searchQuery &&
              !ch.displayName.toLowerCase().includes(searchQuery)
            )
              return false;
            return true;
          })
          .filter((ch) => ch.category === cat);

        if (items.length === 0) return;

        const branch = document.createElement("div");
        branch.className = `tree-branch ${collapsedCGs.has(cat) ? "collapsed" : ""}`;

        const catAllChecked = items.every((ch) => selectedCGs.has(ch.name));
        const header = document.createElement("div");
        header.className = `tree-cat ${catAllChecked ? "checked" : ""}`;
        header.innerHTML = `
          <span class="tree-toggle">▾</span>
          <span class="tree-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          <span class="tree-cat-label">${cat}</span>
          <span class="tree-cat-count">${items.length}</span>
        `;
        header.querySelector(".tree-check").addEventListener("click", (e) => {
          e.stopPropagation();
          const shouldCheck = !header.classList.contains("checked");
          items.forEach((ch) => {
            if (shouldCheck) selectedCGs.add(ch.name);
            else selectedCGs.delete(ch.name);
          });
          renderCGs();
        });
        header.addEventListener("click", (e) => {
          if (e.target.closest(".tree-check")) return;
          branch.classList.toggle("collapsed");
          if (branch.classList.contains("collapsed")) collapsedCGs.add(cat);
          else collapsedCGs.delete(cat);
          header.querySelector(".tree-toggle").textContent =
            branch.classList.contains("collapsed") ? "▸" : "▾";
        });

        const list = document.createElement("div");
        list.className = "tree-items";
        items.forEach((ch) => {
          const checked = selectedCGs.has(ch.name);
          const row = document.createElement("label");
          row.className = `tree-row ${checked ? "checked" : ""}`;
          row.innerHTML = `
            <input type="checkbox" ${checked ? "checked" : ""} value="${ch.name}" />
            <span class="tree-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span class="tree-row-label">${ch.displayName}</span>
          `;
          row.addEventListener("click", () => {
            const cb = row.querySelector("input");
            cb.checked = !cb.checked;
            cb.dispatchEvent(new Event("change"));
          });
          row.querySelector("input").addEventListener("change", (e) => {
            if (e.target.checked) {
              selectedCGs.add(ch.name);
              row.classList.add("checked");
            } else {
              selectedCGs.delete(ch.name);
              row.classList.remove("checked");
            }
            updateUI();
          });
          list.appendChild(row);
        });

        branch.append(header, list);
        fragment.appendChild(branch);
      });

      cgsTree.innerHTML = "";
      cgsTree.appendChild(fragment);
      updateUI();
      checkNoResults();
    }

    function renderVoicelines() {
      const cats = [...new Set(CHARACTERS.map((c) => c.category))];
      const fragment = document.createDocumentFragment();

      cats.forEach((cat) => {
        const chars = CHARACTERS.filter((ch) => {
          if (vlCategoryFilter !== "all" && ch.category !== vlCategoryFilter)
            return false;
          if (
            searchQuery &&
            !ch.displayName.toLowerCase().includes(searchQuery) &&
            !ch.name.toLowerCase().includes(searchQuery)
          )
            return false;
          return true;
        }).filter((ch) => ch.category === cat);

        if (chars.length === 0) return;

        const catAllChecked = chars.every((ch) =>
          ch.attires.every((a) =>
            LANGUAGES.every((l) =>
              selectedVLs.has(`${ch.slug}|${a.name}|${l}`),
            ),
          ),
        );
        const branch = document.createElement("div");
        branch.className = `tree-branch ${collapsedCGs.has(cat) ? "collapsed" : ""}`;

        const header = document.createElement("div");
        header.className = `tree-cat ${catAllChecked ? "checked" : ""}`;
        header.innerHTML = `
          <span class="tree-toggle">▾</span>
          <span class="tree-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          <span class="tree-cat-label">${cat}</span>
          <span class="tree-cat-count">${chars.length}</span>
        `;
        header.querySelector(".tree-check").addEventListener("click", (e) => {
          e.stopPropagation();
          const shouldCheck = !header.classList.contains("checked");
          chars.forEach((ch) => {
            ch.attires.forEach((a) => {
              LANGUAGES.forEach((l) => {
                const key = `${ch.slug}|${a.name}|${l}`;
                if (shouldCheck)
                  selectedVLs.set(key, {
                    slug: ch.slug,
                    attire: a.name,
                    language: l,
                    displayName: ch.displayName,
                  });
                else selectedVLs.delete(key);
              });
            });
          });
          renderVoicelines();
        });
        header.addEventListener("click", (e) => {
          if (e.target.closest(".tree-check")) return;
          branch.classList.toggle("collapsed");
          if (branch.classList.contains("collapsed")) collapsedCGs.add(cat);
          else collapsedCGs.delete(cat);
          header.querySelector(".tree-toggle").textContent =
            branch.classList.contains("collapsed") ? "▸" : "▾";
        });

        const list = document.createElement("div");
        list.className = "tree-items";
        chars.forEach((ch) => {
          const charRow = document.createElement("div");
          charRow.className = "tree-char";

          const charChecked = ch.attires.every((a) =>
            LANGUAGES.every((l) =>
              selectedVLs.has(`${ch.slug}|${a.name}|${l}`),
            ),
          );

          const charHeader = document.createElement("div");
          charHeader.className = `tree-char-header ${charChecked ? "checked" : ""}`;
          const attireCount = ch.attires.length;
          const selectedCountForChar = [...selectedVLs.keys()].filter((k) =>
            k.startsWith(ch.slug + "|"),
          ).length;

          charHeader.innerHTML = `
            <span class="tree-toggle">▸</span>
            <span class="tree-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span class="tree-char-label">${ch.displayName}</span>
            <span class="tree-char-meta">${attireCount} attire${attireCount !== 1 ? "s" : ""} · 4 languages</span>
            <span class="tree-char-selected ${selectedCountForChar > 0 ? "has" : ""}">${selectedCountForChar} selected</span>
          `;

          let expanded = selectedCountForChar > 0 || currentView !== "cgs";
          if (expanded)
            charHeader.querySelector(".tree-toggle").textContent = "▾";
          if (collapsedChars.has(ch.slug)) {
            charRow.classList.add("collapsed");
          } else if (!expanded) {
            charRow.classList.add("collapsed");
          }

          charHeader
            .querySelector(".tree-check")
            .addEventListener("click", (e) => {
              e.stopPropagation();
              const shouldCheck = !charHeader.classList.contains("checked");
              ch.attires.forEach((attire) => {
                LANGUAGES.forEach((lang) => {
                  const key = `${ch.slug}|${attire.name}|${lang}`;
                  if (shouldCheck) {
                    selectedVLs.set(key, {
                      slug: ch.slug,
                      attire: attire.name,
                      language: lang,
                      displayName: ch.displayName,
                    });
                  } else {
                    selectedVLs.delete(key);
                  }
                });
              });
              renderVoicelines();
            });

          charHeader.addEventListener("click", (e) => {
            if (
              e.target.closest(".tree-lang-btn") ||
              e.target.closest(".tree-check")
            )
              return;
            charRow.classList.toggle("collapsed");
            if (charRow.classList.contains("collapsed"))
              collapsedChars.add(ch.slug);
            else collapsedChars.delete(ch.slug);
            const toggle = charHeader.querySelector(".tree-toggle");
            toggle.textContent = charRow.classList.contains("collapsed")
              ? "▸"
              : "▾";
          });

          const attireList = document.createElement("div");
          attireList.className = "tree-attires";

          ch.attires.forEach((attire) => {
            const attireKey = `${ch.slug}|${attire.name}`;
            const attireChecked = LANGUAGES.every((l) =>
              selectedVLs.has(`${attireKey}|${l}`),
            );

            const attireRow = document.createElement("div");
            attireRow.className = `tree-attire ${attireChecked ? "checked" : ""}`;

            const attireLabel = document.createElement("div");
            attireLabel.className = "tree-attire-label";
            attireLabel.innerHTML = `
              <span class="tree-check-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span>${attire.displayName}</span>
            `;

            attireLabel
              .querySelector(".tree-check-sm")
              .addEventListener("click", (e) => {
                e.stopPropagation();
                const shouldCheck = !attireRow.classList.contains("checked");
                LANGUAGES.forEach((lang) => {
                  const key = `${attireKey}|${lang}`;
                  if (shouldCheck) {
                    selectedVLs.set(key, {
                      slug: ch.slug,
                      attire: attire.name,
                      language: lang,
                      displayName: ch.displayName,
                    });
                  } else {
                    selectedVLs.delete(key);
                  }
                });
                renderVoicelines();
              });

            const langGroup = document.createElement("div");
            langGroup.className = "tree-langs";

            LANGUAGES.forEach((lang) => {
              const key = `${attireKey}|${lang}`;
              const active = selectedVLs.has(key);
              const btn = document.createElement("button");
              btn.className = `tree-lang-btn ${active ? "active" : ""}`;
              btn.textContent = lang[0].toUpperCase() + lang.slice(1, 3);
              btn.addEventListener("click", () => {
                if (selectedVLs.has(key)) {
                  selectedVLs.delete(key);
                } else {
                  selectedVLs.set(key, {
                    slug: ch.slug,
                    attire: attire.name,
                    language: lang,
                    displayName: ch.displayName,
                  });
                }
                renderVoicelines();
              });
              langGroup.appendChild(btn);
            });

            attireRow.append(attireLabel, langGroup);
            attireList.appendChild(attireRow);
          });

          charRow.append(charHeader, attireList);
          list.appendChild(charRow);
        });

        branch.append(header, list);
        fragment.appendChild(branch);
      });

      vlTree.innerHTML = "";
      vlTree.appendChild(fragment);
      updateUI();
      checkNoResults();
    }

    function updateCharSelectedCount(slug, headerEl) {
      const count = [...selectedVLs.keys()].filter((k) =>
        k.startsWith(slug + "|"),
      ).length;
      const span = headerEl.querySelector(".tree-char-selected");
      if (span) {
        span.textContent = `${count} selected`;
        span.classList.toggle("has", count > 0);
      }
    }

    function buildChips() {
      const cgCats = [...new Set(allChapters.map((c) => c.category))];
      cgCats.forEach((cat) => {
        const btn = document.createElement("button");
        btn.className = "chip";
        btn.dataset.cgCat = cat;
        btn.textContent = cat;
        cgCategoryChips.appendChild(btn);
      });
      cgCategoryChips.addEventListener("click", (e) => {
        const btn = e.target.closest(".chip");
        if (!btn || !btn.dataset.cgCat) return;
        cgCategoryChips
          .querySelectorAll(".chip")
          .forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        cgCategoryFilter = btn.dataset.cgCat;
        renderCGs();
      });

      const vlCats = [...new Set(CHARACTERS.map((c) => c.category))];
      vlCats.forEach((cat) => {
        const btn = document.createElement("button");
        btn.className = "chip";
        btn.dataset.vlCat = cat;
        btn.textContent = cat;
        vlCategoryChips.appendChild(btn);
      });
      vlCategoryChips.addEventListener("click", (e) => {
        const btn = e.target.closest(".chip");
        if (!btn || !btn.dataset.vlCat) return;
        vlCategoryChips
          .querySelectorAll(".chip")
          .forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        vlCategoryFilter = btn.dataset.vlCat;
        renderVoicelines();
      });
    }

    function updateUI() {
      const total = selectedCGs.size + selectedVLs.size;
      selectedCount.textContent = `${total} selected`;
      downloadBtn.disabled = total === 0;
    }

    function checkNoResults() {
      const cgItems = cgsTree.querySelectorAll(".tree-row").length;
      const vlItems = vlTree.querySelectorAll(".tree-char").length;
      const visible = searchQuery && cgItems === 0 && vlItems === 0;
      noResults.style.display = visible ? "block" : "none";
    }

    viewTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        viewTabs.forEach((t) => t.classList.remove("active"));
        tab.classList.add("active");
        currentView = tab.dataset.view;
        $("cgsSection").style.display =
          currentView === "voicelines" ? "none" : "";
        $("voicelinesSection").style.display =
          currentView === "cgs" ? "none" : "";
      });
    });

    function openDownloadHelp() {
      if (!downloadHelpModal) return;
      downloadHelpModal.style.display = "flex";
      document.body.classList.add("modal-open");
    }

    function closeDownloadHelp() {
      if (!downloadHelpModal) return;
      downloadHelpModal.style.display = "none";
      document.body.classList.remove("modal-open");
    }

    downloadHelpBtn?.addEventListener("click", openDownloadHelp);
    downloadHelpClose?.addEventListener("click", closeDownloadHelp);
    downloadHelpModal?.addEventListener("click", (e) => {
      if (e.target === downloadHelpModal) closeDownloadHelp();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && downloadHelpModal?.style.display !== "none") {
        closeDownloadHelp();
      }
    });

    searchInput.addEventListener("input", () => {
      searchQuery = searchInput.value.toLowerCase().trim();
      renderCGs();
      renderVoicelines();
    });
    document.addEventListener("keydown", (e) => {
      if (
        e.key === "/" &&
        document.activeElement !== searchInput &&
        !e.target.closest("input,textarea")
      ) {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    selectAllCGs.addEventListener("click", () => {
      allChapters.forEach((ch) => selectedCGs.add(ch.name));
      renderCGs();
    });
    selectAllVLs.addEventListener("click", () => {
      CHARACTERS.forEach((ch) => {
        ch.attires.forEach((attire) => {
          LANGUAGES.forEach((lang) => {
            const key = `${ch.slug}|${attire.name}|${lang}`;
            selectedVLs.set(key, {
              slug: ch.slug,
              attire: attire.name,
              language: lang,
              displayName: ch.displayName,
            });
          });
        });
      });
      renderVoicelines();
    });
    langAllBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const lang = btn.dataset.lang;
        CHARACTERS.forEach((ch) => {
          ch.attires.forEach((attire) => {
            const key = `${ch.slug}|${attire.name}|${lang}`;
            selectedVLs.set(key, {
              slug: ch.slug,
              attire: attire.name,
              language: lang,
              displayName: ch.displayName,
            });
          });
        });
        renderVoicelines();
      });
    });

    deselectAll.addEventListener("click", () => {
      selectedCGs.clear();
      selectedVLs.clear();
      renderCGs();
      renderVoicelines();
    });

    downloadBtn.addEventListener("click", async () => {
      const voicelines = [...selectedVLs.values()];
      const cgs = [...selectedCGs];
      if (voicelines.length === 0 && cgs.length === 0) return;

      downloadBtn.disabled = true;
      downloadBtn.querySelector("span").textContent = "Preparing...";

      try {
        await runDownloadFlow(voicelines, cgs);
      } catch (err) {
        alert(`Failed to prepare download: ${err?.message || err}`);
      } finally {
        downloadBtn.disabled = false;
        downloadBtn.querySelector("span").textContent = "Download Selected";
        updateUI();
      }
    });

    buildChips();
    renderCGs();
    renderVoicelines();
    updateUI();
    checkServerAvailability();
  </script>

